{
  "name": "dynastic",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/sitemap.mjs && node --test scripts/ranking.test.mjs && tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "assets:cut": "node scripts/cutout.mjs && node scripts/clean.mjs",
    "assets:build": "node scripts/build-assets.mjs",
    "audit": "node scripts/shots.mjs",
    "e2e": "node scripts/e2e.mjs",
    "test": "node --test scripts/ranking.test.mjs"
  },
  "dependencies": {
    "framer-motion": "^13.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.5",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "oxlint": "^1.79.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.8",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2"
  }
}
